<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <LangVersion>13.0</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="System.Text.Json" Version="6.0.0-preview" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="**/*.txt" />
  </ItemGroup>

  <!-- later make this a package ref unless the local dev folder exists -->
  <ItemGroup>
    <ProjectReference Include="../YarnSpinner.Shared/YarnSpinner.Shared.csproj" />
    <ProjectReference Include="../YarnSpinner.HostAnalysis/YarnSpinner.HostAnalysis.csproj" />
  </ItemGroup>

</Project>
